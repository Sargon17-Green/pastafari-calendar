    {
      "key": "structure",
      "explanationKey": "cooking.live.explain.structure",
      "source": "מגילת העיתים · הלוח האחרון: ידיעת שם היום",
      "quote": "לאחר שנמצאו גבולות השנה, חשב את מבנה השנה פעם אחת כאשר יום המעשה הוא היום הראשון מבין שני הימים שניתנו, והיום הנשאל המוזן למלאכת המבנה הוא היום הראשון של אותה שנה.",
      "textFragmentUrl": "https://the-scroll-of-the-appointed-times.blogspot.com/2026/08/Megilat-HaItim.html#:~:text=%D7%9C%D7%90%D7%97%D7%A8%20%D7%A9%D7%A0%D7%9E%D7%A6%D7%90%D7%95%20%D7%92%D7%91%D7%95%D7%9C%D7%95%D7%AA%20%D7%94%D7%A9%D7%A0%D7%94%2C%20%D7%97%D7%A9%D7%91%20%D7%90%D7%AA%20%D7%9E%D7%91%D7%A0%D7%94%20%D7%94%D7%A9%D7%A0%D7%94%20%D7%A4%D7%A2%D7%9D%20%D7%90%D7%97%D7%AA%20%D7%9B%D7%90%D7%A9%D7%A8%20%D7%99%D7%95%D7%9D%20%D7%94%D7%9E%D7%A2%D7%A9%D7%94%20%D7%94%D7%95%D7%90%20%D7%94%D7%99%D7%95%D7%9D%20%D7%94%D7%A8%D7%90%D7%A9%D7%95%D7%9F%20%D7%9E%D7%91%D7%99%D7%9F%20%D7%A9%D7%A0%D7%99%20%D7%94%D7%99%D7%9E%D7%99%D7%9D%20%D7%A9%D7%A0%D7%99%D7%AA%D7%A0%D7%95%2C%20%D7%95%D7%94%D7%99%D7%95%D7%9D%20%D7%94%D7%A0%D7%A9%D7%90%D7%9C%20%D7%94%D7%9E%D7%95%D7%96%D7%9F%20%D7%9C%D7%9E%D7%9C%D7%90%D7%9B%D7%AA%20%D7%94%D7%9E%D7%91%D7%A0%D7%94%20%D7%94%D7%95%D7%90%20%D7%94%D7%99%D7%95%D7%9D%20%D7%94%D7%A8%D7%90%D7%A9%D7%95%D7%9F%20%D7%A9%D7%9C%20%D7%90%D7%95%D7%AA%D7%94%20%D7%A9%D7%A0%D7%94."
