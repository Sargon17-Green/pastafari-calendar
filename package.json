{
  "name": "pastafari-calendar",
  "version": "1.3.0",
  "type": "module",
  "main": "./src/public-api.js",
  "exports": {
    ".": {
      "types": "./types/5fd0767aaf5331241ec60f8540edf2a6.d.ts",
      "import": "./src/public-api.js"
    },
    "./reverse": {
      "types": "./types/5fd0767aaf5331241ec60f8540edf2a6.d.ts",
      "import": "./browser/pastafari-reverse.js"
    },
    "./constraints": {
      "types": "./types/5fd0767aaf5331241ec60f8540edf2a6.d.ts",
      "import": "./browser/pastafari-constraints-client.js"
    },
    "./browser/*": "./browser/*",
    "./package.json": "./package.json"
  },
  "types": "./types/5fd0767aaf5331241ec60f8540edf2a6.d.ts",
  "files": [
    "src/**/*.js",
    "types/**/*.d.ts",
    "browser",
    "docs/calendar-converters.js",
    "docs/chinese-calendrica-detour.js",
    "scripts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:standalone": "node scripts/build-standalone.mjs",
    "gate-data:generate": "node scripts/regenerate-gate-artifacts.mjs --write",
    "gate-data:check": "node scripts/regenerate-gate-artifacts.mjs --check",
    "security:supply-chain": "node scripts/check-supply-chain.mjs",
    "sync:pages-reverse": "node scripts/sync-pages-reverse-engine.mjs",
    "checksums:generate": "node scripts/checksums.mjs generate",
    "checksums:verify": "node scripts/checksums.mjs verify",
    "package:verify": "node scripts/check-package.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify",
    "test:release-infra": "node --test test/release-infrastructure.test.js",
    "test:reference-oracle": "node --test test/reference-oracle.test.js",
    "test": "npm run test:fast",
    "test:fast": "node --test test/calendar-converters.test.js test/ci-change-classifier.test.js test/calendar-input-conventions.test.js test/calendar-properties.test.js test/day-boundary.test.js test/docs-consistency.test.js test/gate-data-regeneration.test.js test/i18n-support-levels.test.js test/memory-analysis.test.js test/month-weaving-domain.test.js test/pages-reverse-engine.test.js test/public-api.test.js test/pwa-i18n.test.js test/release-infrastructure.test.js test/reverse-pages-integration.test.js test/reverse-pages-wiring.test.js test/reverse-search-controller.test.js test/router-cache-lifecycle.test.js test/router-concurrency.test.js test/router-fallback.test.js test/router-memory-bounds.test.js test/runtime-patching.test.js test/update15-random-witness-isolation.test.js test/update09-proleptic-negative-year.test.js test/update12-koki-proleptic.test.js test/update13-intl-semantic-firewall.test.js test/standalone-build.test.js test/reference-oracle.test.js test/update16-authority-boundary.test.js test/year-ceiling-detour.test.js test/update11-vikrama.test.js",
    "test:compatibility": "node --test test/fast-compatibility.test.js",
    "test:deep": "node --test test/constraints.test.js test/diagnostics.test.js test/extreme-performance.test.js test/i18n.test.js test/reverse.test.js test/year-structure.test.js",
    "test:full": "npm run test:fast && npm run test:compatibility && npm run test:deep",
    "test:release": "npm run test:full",
    "test:checkpoint:sides": "node scripts/run-checkpoint-tests.mjs sides",
    "test:checkpoint:exhaustive": "node scripts/run-checkpoint-tests.mjs exhaustive",
    "test:checkpoint:rebuild": "node scripts/run-checkpoint-tests.mjs rebuild",
    "test:exhaustive": "node scripts/run-checkpoint-tests.mjs exhaustive rebuild",
    "test:soak": "node scripts/run-calendar-property-soak.mjs --mode soak",
    "test:soak:engine": "node scripts/soak-fast-engine.mjs soak",
    "test:regression:year-ceiling": "node scripts/run-year-ceiling-regression.mjs",
    "test:file-protocol": "node scripts/run-file-protocol-tests.mjs",
    "test:i18n-lazy": "node scripts/run-i18n-lazy-loading-smoke.mjs",
    "test:i18n-support": "node scripts/run-i18n-support-smoke.mjs",
    "sync:manifest-i18n": "node scripts/sync-manifest-i18n.mjs",
    "check:manifest-i18n": "node scripts/sync-manifest-i18n.mjs --check",
    "test:day-boundary": "node scripts/run-day-boundary-smoke.mjs",
    "test:reverse-ui": "node scripts/run-reverse-ui-smoke.mjs",
    "test:accessibility": "node scripts/run-accessibility-tests.mjs",
    "test:standalone": "npm run build:standalone && npm run test:file-protocol",
    "test:memory:node": "node --expose-gc benchmarks/memory.mjs --mode smoke",
    "test:memory:browser": "node benchmarks/memory-browser.mjs --mode smoke",
    "test:memory": "npm run test:memory:node && npm run test:memory:browser",
    "test:memory:soak": "node --expose-gc benchmarks/memory.mjs --mode soak && node benchmarks/memory-browser.mjs --mode soak",
    "memory:snapshot": "node --expose-gc benchmarks/memory-snapshot.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "check:i18n": "node scripts/i18n-coverage.mjs --check --no-write",
    "report:reverse-i18n": "node scripts/report-reverse-i18n.mjs",
    "check:reverse-i18n": "node scripts/report-reverse-i18n.mjs --require-all",
    "benchmark": "node benchmarks/run.mjs",
    "benchmark:engine": "node benchmarks/engine.mjs",
    "benchmark:web": "node benchmarks/web.mjs",
    "benchmark:reverse": "node benchmarks/reverse-constraints.mjs",
    "benchmark:smoke": "node benchmarks/smoke.mjs",
    "test:visual": "node scripts/run-visual-regression.mjs",
    "test:visual:update": "node scripts/run-visual-regression.mjs --update",
    "test:visual:layout": "node scripts/run-visual-regression.mjs --layout-only",
    "test:visual:self-test": "node scripts/run-visual-regression.mjs --regression-self-test",
    "docs:generate": "node scripts/docs-consistency.mjs --write",
    "docs:check": "node scripts/docs-consistency.mjs",
    "test:ci-change-classifier": "node --test test/ci-change-classifier.test.js",
    "test:runtime-patching": "node --test test/runtime-patching.test.js",
    "test:update11:vikrama": "node --test test/update11-vikrama.test.js && node verification/update11/run-vikrama-final-audit.mjs",
    "test:update11:vikrama:browser": "node scripts/run-update11-vikrama-browser-smoke.mjs",
    "test:update12:koki": "node --test test/update12-koki-proleptic.test.js && node verification/update12/run-koki-audit.mjs",
    "test:update12:koki:browser": "node scripts/run-update12-koki-browser-smoke.mjs",
    "test:update13:intl": "node --test test/update13-intl-semantic-firewall.test.js",
    "test:update13:intl:browser": "node scripts/run-update13-intl-browser-smoke.mjs",
    "test:update13:intl:standalone": "node scripts/check-update13-standalone-firewall.mjs",
    "test:update13:intl:matrix": "node verification/update13/run-environment-matrix.mjs",
    "test:update13:intl:random": "node verification/update13/run-random-differential.mjs",
    "test:update16": "node scripts/run-update16-authority-audit.mjs --write && node --test test/update16-authority-boundary.test.js",
    "evidence:update17:generate": "node verification/update17/generate-canonical-evidence.mjs",
    "evidence:update17:verify": "node verification/update17/verify-canonical-evidence.mjs",
    "evidence:update17:stale": "node verification/update17/check-canonical-stale.mjs",
    "test:update17": "node --test test/update17-canonical-evidence.test.js && node verification/update17/verify-canonical-evidence.mjs && node verification/update17/run-engine-matrix.mjs --engine=fast",
    "test:update17:matrix": "node verification/update17/run-engine-matrix.mjs --engine=authoritative",
    "test:differential:final": "node verification/update18/run-final-differential-integration.mjs",
    "test:differential:final:node": "node verification/update18/run-final-differential-integration.mjs --tier=extended --gate-limit=26 --sauce-limit=6 --year-limit=1 --external-limit=0",
    "test:differential:final:browser": "node verification/update18/run-final-differential-integration.mjs && node scripts/run-update18-browser-final-differential.mjs",
    "test:differential:final:extended": "node verification/update18/run-final-differential-integration.mjs --tier=extended --gate-limit=26 --sauce-limit=6 --year-limit=1 --external-limit=0",
    "test:update18": "node --test test/update18-final-differential-integration.test.js",
    "test:differential:final:closure": "node verification/update18/close-final-status.mjs"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
