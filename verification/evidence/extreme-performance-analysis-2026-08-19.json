  "acceptedOptimization": {
    "name": "bounded exact gate traversal cursor",
    "description": "Keep exactly one previously computed gate index/position pair. On a gatePosition cache miss, use it only when its gate-index distance to the target is strictly less than the distance from the old static checkpoint; otherwise use the original checkpoint. Traverse with the unchanged recurrence.",
    "semanticArgument": "The cursor position is itself produced by the exact gate recurrence. Starting the same recurrence from an exact intermediate state removes duplicate work only; gateDistance, sauce, ordering, precision, outputs, and checkpoint data are unchanged.",
    "memoryGrowth": "constant: two BigInt values; LRU limits remain 4096",
    "sourceDeltaBytes": 732,
    "gzipDeltaBytes": 133,
    "precomputedDataAdded": false
  },
  "toolingFix": {
    "finding": "FastWorker.run() rejected on timeout but did not terminate the worker. Intermediate retries restarted it; the final retry previously returned without restart, so the timed-out CPU job could continue in the background.",
    "fix": "Restart/terminate the worker before returning the final performance-timeout record.",
    "relationshipTo11Cases": "Separate tooling artifact. It can contaminate following-case timing, but does not explain the 11 cases because each was reproduced across bounded retries."
