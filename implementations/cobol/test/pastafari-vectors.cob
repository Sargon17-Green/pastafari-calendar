>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PASTAFARI-VECTORS.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "pastafari-engine.cpy".

01 CALC-VALUE-TABLE.
   05 CALC-VALUES OCCURS 3 PIC S9(18) COMP-5.
01 OFFSET-VALUE-TABLE.
   05 OFFSET-VALUES OCCURS 9 PIC S9(18) COMP-5.
01 I PIC S9(9) COMP-5.
01 J PIC S9(9) COMP-5.
01 CALC-JDN PIC S9(18) COMP-5.
01 TARGET-JDN PIC S9(18) COMP-5.
01 EXPECTED-REVERSE PIC S9(18) COMP-5.
01 SELF-JDN PIC S9(18) COMP-5.
01 SAVED-DATE.
   05 SAVED-YEAR PIC S9(18) COMP-5.
   05 SAVED-CUTLET PIC X(64).
   05 SAVED-DIC PIC 9(9) COMP-5.
   05 SAVED-MONTH PIC X(64).
   05 SAVED-DIM PIC 9(9) COMP-5.

PROCEDURE DIVISION.
MAIN.
    MOVE -13334246 TO CALC-VALUES(1)
    MOVE 2451545 TO CALC-VALUES(2)
    MOVE 2461259 TO CALC-VALUES(3)
    MOVE -1000 TO OFFSET-VALUES(1)
    MOVE -366 TO OFFSET-VALUES(2)
    MOVE -42 TO OFFSET-VALUES(3)
    MOVE -1 TO OFFSET-VALUES(4)
    MOVE 0 TO OFFSET-VALUES(5)
    MOVE 1 TO OFFSET-VALUES(6)
    MOVE 42 TO OFFSET-VALUES(7)
    MOVE 366 TO OFFSET-VALUES(8)
    MOVE 1000 TO OFFSET-VALUES(9)

    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 3
        MOVE CALC-VALUES(I) TO CALC-JDN
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > 9
            COMPUTE TARGET-JDN = CALC-JDN + OFFSET-VALUES(J)
            INITIALIZE PF-REQUEST
            MOVE "F" TO PF-OP
            MOVE CALC-JDN TO PF-CALCULATION-JDN
            MOVE TARGET-JDN TO PF-TARGET-JDN
            CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
            IF PF-STATUS NOT = 0
                DISPLAY "ERROR|forward|" CALC-JDN "|" TARGET-JDN "|" PF-STATUS-CODE
                MOVE 2 TO RETURN-CODE
                STOP RUN
            END-IF
            MOVE PF-YEAR TO SAVED-YEAR
            MOVE PF-CUTLET-NAME TO SAVED-CUTLET
            MOVE PF-DAY-IN-CUTLET TO SAVED-DIC
            MOVE PF-MONTH-NAME TO SAVED-MONTH
            MOVE PF-DAY-IN-MONTH TO SAVED-DIM

            INITIALIZE PF-REQUEST
            MOVE "K" TO PF-OP
            MOVE CALC-JDN TO PF-CALCULATION-JDN
            MOVE SAVED-YEAR TO PF-WANTED-YEAR
            MOVE SAVED-CUTLET TO PF-WANTED-CUTLET-NAME
            MOVE SAVED-DIC TO PF-WANTED-DAY-IN-CUTLET
            MOVE SAVED-MONTH TO PF-WANTED-MONTH-NAME
            MOVE SAVED-DIM TO PF-WANTED-DAY-IN-MONTH
            CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
            IF PF-STATUS NOT = 0 OR PF-FOUND NOT = "Y" OR PF-FOUND-TARGET-JDN NOT = TARGET-JDN
                DISPLAY "ERROR|reverse-known|" CALC-JDN "|" TARGET-JDN "|" PF-STATUS-CODE
                MOVE 3 TO RETURN-CODE
                STOP RUN
            END-IF
            MOVE PF-FOUND-TARGET-JDN TO EXPECTED-REVERSE
            DISPLAY "VECTOR|" CALC-JDN "|" TARGET-JDN "|" SAVED-YEAR "|"
                    SAVED-CUTLET "|" SAVED-DIC "|" SAVED-MONTH "|" SAVED-DIM "|"
                    EXPECTED-REVERSE
        END-PERFORM
    END-PERFORM

    MOVE 2461259 TO SELF-JDN
    INITIALIZE PF-REQUEST
    MOVE "F" TO PF-OP
    MOVE SELF-JDN TO PF-CALCULATION-JDN PF-TARGET-JDN
    CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
    IF PF-STATUS NOT = 0
        DISPLAY "ERROR|self-forward|" PF-STATUS-CODE
        MOVE 4 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE PF-YEAR TO SAVED-YEAR
    MOVE PF-CUTLET-NAME TO SAVED-CUTLET
    MOVE PF-DAY-IN-CUTLET TO SAVED-DIC
    MOVE PF-MONTH-NAME TO SAVED-MONTH
    MOVE PF-DAY-IN-MONTH TO SAVED-DIM

    INITIALIZE PF-REQUEST
    MOVE "S" TO PF-OP
    MOVE SAVED-YEAR TO PF-WANTED-YEAR
    MOVE SAVED-CUTLET TO PF-WANTED-CUTLET-NAME
    MOVE SAVED-DIC TO PF-WANTED-DAY-IN-CUTLET
    MOVE SAVED-MONTH TO PF-WANTED-MONTH-NAME
    MOVE SAVED-DIM TO PF-WANTED-DAY-IN-MONTH
    MOVE SELF-JDN TO PF-SEARCH-START-JDN PF-SEARCH-END-JDN
    MOVE 1 TO PF-RESULT-LIMIT
    CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
    IF PF-STATUS NOT = 0 OR PF-RESULT-COUNT NOT = 1 OR PF-RESULT-JDN(1) NOT = SELF-JDN
        DISPLAY "ERROR|reverse-self|" PF-STATUS-CODE
        MOVE 5 TO RETURN-CODE
        STOP RUN
    END-IF
    DISPLAY "SELF|" SELF-JDN "|" SAVED-YEAR "|" SAVED-CUTLET "|" SAVED-DIC "|"
            SAVED-MONTH "|" SAVED-DIM
    MOVE 0 TO RETURN-CODE
    STOP RUN.
END PROGRAM PASTAFARI-VECTORS.
