>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PASTAFARI-BATCH.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT REQUEST-FILE ASSIGN TO DYNAMIC REQUEST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS REQUEST-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD REQUEST-FILE.
01 REQUEST-LINE PIC X(1024).

WORKING-STORAGE SECTION.
COPY "pastafari-engine.cpy".

01 REQUEST-PATH PIC X(1024).
01 REQUEST-FILE-STATUS PIC XX.
01 EOF-FLAG PIC X VALUE "N".
   88 END-OF-FILE VALUE "Y".
01 WS-OP-TEXT PIC X(8).
01 WS-ID PIC X(24).
01 WS-T1 PIC X(128).
01 WS-T2 PIC X(128).
01 WS-T3 PIC X(128).
01 WS-T4 PIC X(128).
01 WS-T5 PIC X(128).
01 WS-T6 PIC X(128).
01 WS-T7 PIC X(128).
01 WS-T8 PIC X(128).
01 WS-T9 PIC X(128).
01 WS-I PIC S9(9) COMP-5.
01 WS-REVERSE-FLAG PIC X.
01 WS-SAVED-DATE.
   05 WS-SAVED-YEAR PIC S9(18) COMP-5.
   05 WS-SAVED-CUTLET PIC X(64).
   05 WS-SAVED-DIC PIC 9(9) COMP-5.
   05 WS-SAVED-MONTH PIC X(64).
   05 WS-SAVED-DIM PIC 9(9) COMP-5.
01 WS-SAVED-STATUS PIC S9(9) COMP-5.
01 WS-SAVED-STATUS-CODE PIC X(32).

PROCEDURE DIVISION.
MAIN.
    ACCEPT REQUEST-PATH FROM COMMAND-LINE
    IF FUNCTION LENGTH(FUNCTION TRIM(REQUEST-PATH)) = 0
        DISPLAY "E|0|ERR_BATCH_ARGUMENT|request file path is required"
        MOVE 2 TO RETURN-CODE
        STOP RUN
    END-IF

    OPEN INPUT REQUEST-FILE
    IF REQUEST-FILE-STATUS NOT = "00"
        DISPLAY "E|0|ERR_BATCH_OPEN|" REQUEST-FILE-STATUS
        MOVE 3 TO RETURN-CODE
        STOP RUN
    END-IF

    PERFORM UNTIL END-OF-FILE
        READ REQUEST-FILE
            AT END
                MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF FUNCTION LENGTH(FUNCTION TRIM(REQUEST-LINE)) > 0
                    PERFORM PROCESS-REQUEST
                END-IF
        END-READ
    END-PERFORM

    CLOSE REQUEST-FILE
    MOVE 0 TO RETURN-CODE
    STOP RUN.

PROCESS-REQUEST.
    MOVE SPACES TO WS-OP-TEXT WS-ID WS-T1 WS-T2 WS-T3 WS-T4 WS-T5 WS-T6 WS-T7 WS-T8 WS-T9
    UNSTRING REQUEST-LINE DELIMITED BY "|"
        INTO WS-OP-TEXT WS-ID WS-T1 WS-T2 WS-T3 WS-T4 WS-T5 WS-T6 WS-T7 WS-T8 WS-T9
    END-UNSTRING

    EVALUATE FUNCTION TRIM(WS-OP-TEXT)
        WHEN "F"
            PERFORM PROCESS-FORWARD
        WHEN "K"
            PERFORM PROCESS-REVERSE-KNOWN
        WHEN "S"
            PERFORM PROCESS-REVERSE-SELF
        WHEN OTHER
            DISPLAY "E|" FUNCTION TRIM(WS-ID) "|ERR_BATCH_OPERATION|" FUNCTION TRIM(WS-OP-TEXT)
    END-EVALUATE.

PROCESS-FORWARD.
    INITIALIZE PF-REQUEST PF-RESPONSE
    MOVE "F" TO PF-OP
    COMPUTE PF-CALCULATION-JDN = FUNCTION NUMVAL(FUNCTION TRIM(WS-T1))
    COMPUTE PF-TARGET-JDN = FUNCTION NUMVAL(FUNCTION TRIM(WS-T2))
    MOVE FUNCTION TRIM(WS-T3) TO WS-REVERSE-FLAG

    CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
    MOVE PF-STATUS TO WS-SAVED-STATUS
    MOVE PF-STATUS-CODE TO WS-SAVED-STATUS-CODE

    IF PF-STATUS = 0
        MOVE PF-YEAR TO WS-SAVED-YEAR
        MOVE PF-CUTLET-NAME TO WS-SAVED-CUTLET
        MOVE PF-DAY-IN-CUTLET TO WS-SAVED-DIC
        MOVE PF-MONTH-NAME TO WS-SAVED-MONTH
        MOVE PF-DAY-IN-MONTH TO WS-SAVED-DIM
    ELSE
        INITIALIZE WS-SAVED-DATE
    END-IF

    IF PF-STATUS = 0 AND WS-REVERSE-FLAG = "R"
        INITIALIZE PF-REQUEST PF-RESPONSE
        MOVE "K" TO PF-OP
        COMPUTE PF-CALCULATION-JDN = FUNCTION NUMVAL(FUNCTION TRIM(WS-T1))
        MOVE WS-SAVED-YEAR TO PF-WANTED-YEAR
        MOVE WS-SAVED-CUTLET TO PF-WANTED-CUTLET-NAME
        MOVE WS-SAVED-DIC TO PF-WANTED-DAY-IN-CUTLET
        MOVE WS-SAVED-MONTH TO PF-WANTED-MONTH-NAME
        MOVE WS-SAVED-DIM TO PF-WANTED-DAY-IN-MONTH
        CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
    ELSE
        MOVE "N" TO PF-FOUND
        MOVE 0 TO PF-FOUND-TARGET-JDN
    END-IF

    DISPLAY "F|" FUNCTION TRIM(WS-ID) "|" WS-SAVED-STATUS "|"
            FUNCTION TRIM(WS-SAVED-STATUS-CODE) "|"
            FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) "|"
            WS-SAVED-YEAR "|" WS-SAVED-CUTLET "|" WS-SAVED-DIC "|"
            WS-SAVED-MONTH "|" WS-SAVED-DIM "|"
            PF-STATUS "|" FUNCTION TRIM(PF-STATUS-CODE) "|"
            PF-FOUND "|" PF-FOUND-TARGET-JDN.

PROCESS-REVERSE-KNOWN.
    INITIALIZE PF-REQUEST PF-RESPONSE
    MOVE "K" TO PF-OP
    COMPUTE PF-CALCULATION-JDN = FUNCTION NUMVAL(FUNCTION TRIM(WS-T1))
    COMPUTE PF-WANTED-YEAR = FUNCTION NUMVAL(FUNCTION TRIM(WS-T2))
    MOVE WS-T3 TO PF-WANTED-CUTLET-NAME
    COMPUTE PF-WANTED-DAY-IN-CUTLET = FUNCTION NUMVAL(FUNCTION TRIM(WS-T4))
    MOVE WS-T5 TO PF-WANTED-MONTH-NAME
    COMPUTE PF-WANTED-DAY-IN-MONTH = FUNCTION NUMVAL(FUNCTION TRIM(WS-T6))

    CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
    DISPLAY "K|" FUNCTION TRIM(WS-ID) "|" PF-STATUS "|"
            FUNCTION TRIM(PF-STATUS-CODE) "|" PF-FOUND "|" PF-FOUND-TARGET-JDN.

PROCESS-REVERSE-SELF.
    INITIALIZE PF-REQUEST PF-RESPONSE
    MOVE "S" TO PF-OP
    COMPUTE PF-WANTED-YEAR = FUNCTION NUMVAL(FUNCTION TRIM(WS-T1))
    MOVE WS-T2 TO PF-WANTED-CUTLET-NAME
    COMPUTE PF-WANTED-DAY-IN-CUTLET = FUNCTION NUMVAL(FUNCTION TRIM(WS-T3))
    MOVE WS-T4 TO PF-WANTED-MONTH-NAME
    COMPUTE PF-WANTED-DAY-IN-MONTH = FUNCTION NUMVAL(FUNCTION TRIM(WS-T5))
    COMPUTE PF-SEARCH-START-JDN = FUNCTION NUMVAL(FUNCTION TRIM(WS-T6))
    COMPUTE PF-SEARCH-END-JDN = FUNCTION NUMVAL(FUNCTION TRIM(WS-T7))
    COMPUTE PF-RESULT-LIMIT = FUNCTION NUMVAL(FUNCTION TRIM(WS-T8))

    CALL "PASTAFARI-ENGINE" USING PF-REQUEST PF-RESPONSE
    DISPLAY "S|" FUNCTION TRIM(WS-ID) "|" PF-STATUS "|"
            FUNCTION TRIM(PF-STATUS-CODE) "|" PF-RESULT-COUNT "|"
            PF-HAS-MORE "|" PF-NEXT-START-JDN
    IF PF-STATUS = 0
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PF-RESULT-COUNT
            DISPLAY "J|" FUNCTION TRIM(WS-ID) "|" WS-I "|" PF-RESULT-JDN(WS-I)
        END-PERFORM
    END-IF.

END PROGRAM PASTAFARI-BATCH.
