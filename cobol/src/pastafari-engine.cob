            COMPUTE WS-CALC-NUMBER = 2 * WS-I64 + 1
        ELSE
            COMPUTE WS-CALC-NUMBER = -2 * WS-I64
        END-IF
    END-IF
    COMPUTE WS-I64 = SC-TARGET-JDN - PF-FOUNDATION-JDN
    IF WS-I64 = 0
        MOVE 1 TO WS-TARGET-NUMBER
    ELSE
        IF WS-I64 > 0
            COMPUTE WS-TARGET-NUMBER = 2 * WS-I64 + 1
        ELSE
            COMPUTE WS-TARGET-NUMBER = -2 * WS-I64
        END-IF
    END-IF
    COMPUTE WS-DISTANCE = FUNCTION ABS(SC-TARGET-JDN - SC-CALC-JDN) + 1
    COMPUTE WS-SUM = WS-CALC-NUMBER + WS-TARGET-NUMBER
    IF SC-TARGET-JDN < SC-CALC-JDN
        MOVE 1 TO WS-DIRECTION
    ELSE
        IF SC-TARGET-JDN = SC-CALC-JDN
            MOVE 2 TO WS-DIRECTION
        ELSE
            MOVE 3 TO WS-DIRECTION
        END-IF
    END-IF.

