            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(20) BY VALUE SIZE AUTO GRIND-B(WS-J)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(21) BY VALUE SIZE AUTO GRIND-C(WS-J)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(22) BY VALUE SIZE AUTO GRIND-D(WS-J)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            MOVE GRIND-STONE(WS-J) TO WS-K
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-STONE(WS-I,WS-K)
            CALL "pfbi_keep" USING BY VALUE BI-DROPS(WS-I) BY VALUE BI-TEMP(1) BY VALUE BI-GREAT
        END-PERFORM

        *> JS: 1 + ((x - 1) mod 720), not 1 + (x mod 720).
        CALL "pfbi_add_si" USING BY VALUE BI-TEMP(16) BY VALUE BI-DROPS(WS-I) BY VALUE SIZE AUTO CM1
        CALL "pfbi_mod_ui" USING BY VALUE BI-TEMP(16) BY VALUE SIZE AUTO C720 RETURNING WS-I64
        ADD 1 TO WS-I64 GIVING PERM-RANK
        PERFORM BOWL-PERMUTATION
        IF WS-I = 46
            PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
                MOVE PERM-RESULT(WS-J) TO LAST-PERM(WS-J)
            END-PERFORM
        END-IF
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
            CALL "pfbi_set_ui" USING BY VALUE BI-DIRECT(WS-J) BY VALUE SIZE AUTO C0
        END-PERFORM
        PERFORM VARYING WS-PLACE FROM 1 BY 1 UNTIL WS-PLACE > 3
            MOVE PERM-RESULT(WS-PLACE) TO WS-BOWL-ID
            CALL "pfbi_square" USING BY VALUE BI-TEMP(1) BY VALUE BI-DROPS(WS-I)
            MOVE DIRECT-STONE(WS-PLACE) TO WS-K
            CALL "pfbi_mul" USING BY VALUE BI-TEMP(2) BY VALUE BI-STONE(WS-I,WS-K) BY VALUE BI-BOWLS(WS-BOWL-ID)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            COMPUTE WS-I64 = DIRECT-MULT(WS-PLACE) * WS-I
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
            CALL "pfbi_keep" USING BY VALUE BI-DIRECT(WS-BOWL-ID) BY VALUE BI-TEMP(1) BY VALUE BI-GREAT
        END-PERFORM
        PERFORM VARYING WS-PLACE FROM 1 BY 1 UNTIL WS-PLACE > 6
            MOVE PERM-RESULT(WS-PLACE) TO WS-BOWL-ID
            COMPUTE WS-J = WS-PLACE - 1
            IF WS-J < 1 MOVE 6 TO WS-J END-IF
            MOVE PERM-RESULT(WS-J) TO WS-PREV-ID
            COMPUTE WS-J = WS-PLACE + 1
            IF WS-J > 6 MOVE 1 TO WS-J END-IF
            MOVE PERM-RESULT(WS-J) TO WS-NEXT-ID
            CALL "pfbi_copy" USING BY VALUE BI-TEMP(1) BY VALUE BI-BOWLS(WS-BOWL-ID)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-BOWLS(WS-PREV-ID) BY VALUE SIZE AUTO C2
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-BOWLS(WS-NEXT-ID) BY VALUE SIZE AUTO C3
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-DIRECT(WS-BOWL-ID)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-DROPS(WS-I)
            MOVE DROP-MIX-STONE(WS-PLACE) TO WS-K
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-STONE(WS-I,WS-K)
            CALL "pfbi_square" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(1)
            CALL "pfbi_mul" USING BY VALUE BI-TEMP(3) BY VALUE BI-BOWLS(WS-PREV-ID) BY VALUE BI-BOWLS(WS-NEXT-ID)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(3) BY VALUE SIZE AUTO C5
            CALL "pfbi_add" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(3)
            COMPUTE WS-I64 = WS-I * WS-PLACE
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE SIZE AUTO WS-I64
            CALL "pfbi_keep" USING BY VALUE BI-NEXT-BOWLS(WS-BOWL-ID) BY VALUE BI-TEMP(2) BY VALUE BI-GREAT
        END-PERFORM
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
            CALL "pfbi_copy" USING BY VALUE BI-BOWLS(WS-J) BY VALUE BI-NEXT-BOWLS(WS-J)
        END-PERFORM
    END-PERFORM

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
        CALL "pfbi_set_ui" USING BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO C0
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-BOWLS(WS-J)
        END-PERFORM
        COMPUTE WS-I64 = 149 * WS-I
        CALL "pfbi_add_si" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
        CALL "pfbi_keep" USING BY VALUE BI-TEMP(15) BY VALUE BI-TEMP(1) BY VALUE BI-GREAT
        *> JS: 1 + ((orderNumber - 1) mod 720).
        CALL "pfbi_add_si" USING BY VALUE BI-TEMP(16) BY VALUE BI-TEMP(15) BY VALUE SIZE AUTO CM1
        CALL "pfbi_mod_ui" USING BY VALUE BI-TEMP(16) BY VALUE SIZE AUTO C720 RETURNING WS-I64
        ADD 1 TO WS-I64 GIVING PERM-RANK
        PERFORM BOWL-PERMUTATION
        PERFORM VARYING WS-PLACE FROM 1 BY 1 UNTIL WS-PLACE > 6
            MOVE PERM-RESULT(WS-PLACE) TO WS-BOWL-ID
            COMPUTE WS-J = WS-PLACE - 1
            IF WS-J < 1 MOVE 6 TO WS-J END-IF
            MOVE PERM-RESULT(WS-J) TO WS-PREV-ID
            COMPUTE WS-J = WS-PLACE + 1
            IF WS-J > 6 MOVE 1 TO WS-J END-IF
            MOVE PERM-RESULT(WS-J) TO WS-NEXT-ID
            CALL "pfbi_copy" USING BY VALUE BI-TEMP(1) BY VALUE BI-BOWLS(WS-BOWL-ID)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-BOWLS(WS-PREV-ID) BY VALUE SIZE AUTO C3
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-BOWLS(WS-NEXT-ID) BY VALUE SIZE AUTO C5
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(2)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(15)
            MOVE WS-I TO WS-I64
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
            COMPUTE WS-I64 = WS-PLACE * WS-PLACE
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
            CALL "pfbi_square" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(1)
            CALL "pfbi_mul" USING BY VALUE BI-TEMP(3) BY VALUE BI-BOWLS(WS-PREV-ID) BY VALUE BI-BOWLS(WS-NEXT-ID)
            CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(3) BY VALUE SIZE AUTO C7
            CALL "pfbi_add" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(3)
            CALL "pfbi_keep" USING BY VALUE BI-NEXT-BOWLS(WS-BOWL-ID) BY VALUE BI-TEMP(2) BY VALUE BI-GREAT
        END-PERFORM
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
            CALL "pfbi_copy" USING BY VALUE BI-BOWLS(WS-J) BY VALUE BI-NEXT-BOWLS(WS-J)
        END-PERFORM
    END-PERFORM.

BOWL-PERMUTATION.
    COMPUTE PERM-RANK = PERM-RANK - 1
    MOVE 6 TO PERM-AVAIL-COUNT
    PERFORM VARYING PERM-WORK-I FROM 1 BY 1 UNTIL PERM-WORK-I > 6
        MOVE PERM-WORK-I TO PERM-AVAILABLE(PERM-WORK-I)
    END-PERFORM
    PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > 6
        COMPUTE PERM-WORK-I = 7 - WS-POS
        MOVE FACTORIAL(PERM-WORK-I) TO PERM-BLOCK
        DIVIDE PERM-RANK BY PERM-BLOCK GIVING PERM-QUOTIENT REMAINDER PERM-RANK
        COMPUTE PERM-SLOT = PERM-QUOTIENT + 1
        MOVE PERM-AVAILABLE(PERM-SLOT) TO PERM-RESULT(WS-POS)
        PERFORM VARYING PERM-SHIFT-I FROM PERM-SLOT BY 1 UNTIL PERM-SHIFT-I >= PERM-AVAIL-COUNT
            COMPUTE PERM-SHIFT-NEXT = PERM-SHIFT-I + 1
            MOVE PERM-AVAILABLE(PERM-SHIFT-NEXT) TO PERM-AVAILABLE(PERM-SHIFT-I)
        END-PERFORM
        SUBTRACT 1 FROM PERM-AVAIL-COUNT
    END-PERFORM.

CHOOSE-UNIFORM.
    MOVE 0 TO WS-POS
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
        IF LAST-PERM(WS-I) = CU-BOWL-ID MOVE WS-I TO WS-POS END-IF
    END-PERFORM
    IF WS-POS = 0
        MOVE 901 TO PF-STATUS
        MOVE "ERR_INTERNAL_PERM" TO PF-STATUS-CODE
        MOVE "response descriptor could not find bowl in final permutation" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-I = WS-POS + 1
    IF WS-I > 6 MOVE 1 TO WS-I END-IF
    MOVE LAST-PERM(WS-I) TO WS-NEXT-ID

    CALL "pfbi_copy" USING BY VALUE BI-TEMP(1) BY VALUE BI-BOWLS(CU-BOWL-ID)
    COMPUTE WS-I64 = CU-SEAL + 181
    CALL "pfbi_add_si" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
    CALL "pfbi_square" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(1)
    CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(3) BY VALUE BI-BOWLS(WS-NEXT-ID) BY VALUE SIZE AUTO C179
    CALL "pfbi_add" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(3)
    CALL "pfbi_add_si" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE SIZE AUTO CU-SEAL
    CALL "pfbi_keep" USING BY VALUE RD-FIRST BY VALUE BI-TEMP(2) BY VALUE BI-GREAT

    CALL "pfbi_copy" USING BY VALUE BI-TEMP(1) BY VALUE RD-FIRST
    COMPUTE WS-I64 = CU-SEAL + 194
    CALL "pfbi_add_si" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
    CALL "pfbi_square" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(1)
    CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(3) BY VALUE RD-FIRST BY VALUE SIZE AUTO C193
    CALL "pfbi_add" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(3)
    CALL "pfbi_mul_si" USING BY VALUE BI-TEMP(3) BY VALUE BI-BOWLS(6) BY VALUE SIZE AUTO C197
    CALL "pfbi_add" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(3)
    CALL "pfbi_keep" USING BY VALUE BI-TEMP(4) BY VALUE BI-TEMP(2) BY VALUE BI-GREAT
    CALL "pfbi_mod_ui" USING BY VALUE BI-TEMP(4) BY VALUE SIZE AUTO C2 RETURNING WS-I64
    IF WS-I64 = 1 MOVE 1 TO RD-STEP ELSE MOVE -1 TO RD-STEP END-IF

    CALL "pfbi_cmp" USING BY VALUE BI-COUNT BY VALUE BI-GREAT RETURNING WS-RC
    IF WS-RC <= 0
        CALL "pfbi_mod" USING BY VALUE BI-TEMP(1) BY VALUE BI-GREAT BY VALUE BI-COUNT
        CALL "pfbi_sub" USING BY VALUE BI-TEMP(2) BY VALUE BI-GREAT BY VALUE BI-TEMP(1)
        CALL "pfbi_copy" USING BY VALUE BI-TEMP(3) BY VALUE RD-FIRST
        CALL "pfbi_cmp" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(2) RETURNING WS-RC
        IF WS-RC > 0
            IF RD-STEP > 0
                CALL "pfbi_copy" USING BY VALUE BI-TEMP(3) BY VALUE BI-ONE
            ELSE
                CALL "pfbi_copy" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(2)
            END-IF
        END-IF
        CALL "pfbi_add_si" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(3) BY VALUE SIZE AUTO CM1
        CALL "pfbi_mod" USING BY VALUE BI-CHOICE BY VALUE BI-TEMP(3) BY VALUE BI-COUNT
        CALL "pfbi_add_si" USING BY VALUE BI-CHOICE BY VALUE BI-CHOICE BY VALUE SIZE AUTO C1
    ELSE
        MOVE 1 TO WS-I
        CALL "pfbi_copy" USING BY VALUE BI-TEMP(6) BY VALUE BI-GREAT
        CALL "pfbi_cmp" USING BY VALUE BI-TEMP(6) BY VALUE BI-COUNT RETURNING WS-RC
        PERFORM UNTIL WS-RC >= 0
            CALL "pfbi_mul" USING BY VALUE BI-TEMP(6) BY VALUE BI-TEMP(6) BY VALUE BI-GREAT
            ADD 1 TO WS-I
            CALL "pfbi_cmp" USING BY VALUE BI-TEMP(6) BY VALUE BI-COUNT RETURNING WS-RC
        END-PERFORM
        CALL "pfbi_copy" USING BY VALUE BI-TEMP(7) BY VALUE BI-ONE
        CALL "pfbi_copy" USING BY VALUE BI-TEMP(8) BY VALUE BI-ONE
        PERFORM VARYING WS-J FROM 0 BY 1 UNTIL WS-J >= WS-I
            CALL "pfbi_copy" USING BY VALUE BI-TEMP(9) BY VALUE RD-FIRST
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(9) BY VALUE BI-TEMP(9) BY VALUE SIZE AUTO CM1
            COMPUTE WS-I64 = RD-STEP * WS-J
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(9) BY VALUE BI-TEMP(9) BY VALUE SIZE AUTO WS-I64
            CALL "pfbi_mod" USING BY VALUE BI-TEMP(9) BY VALUE BI-TEMP(9) BY VALUE BI-GREAT
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(9) BY VALUE BI-TEMP(9) BY VALUE SIZE AUTO C1
            CALL "pfbi_add_si" USING BY VALUE BI-TEMP(9) BY VALUE BI-TEMP(9) BY VALUE SIZE AUTO CM1
            CALL "pfbi_mul" USING BY VALUE BI-TEMP(10) BY VALUE BI-TEMP(9) BY VALUE BI-TEMP(8)
            CALL "pfbi_add" USING BY VALUE BI-TEMP(7) BY VALUE BI-TEMP(7) BY VALUE BI-TEMP(10)
            CALL "pfbi_mul" USING BY VALUE BI-TEMP(8) BY VALUE BI-TEMP(8) BY VALUE BI-GREAT
        END-PERFORM
        CALL "pfbi_mod" USING BY VALUE BI-TEMP(1) BY VALUE BI-TEMP(6) BY VALUE BI-COUNT
        CALL "pfbi_sub" USING BY VALUE BI-TEMP(2) BY VALUE BI-TEMP(6) BY VALUE BI-TEMP(1)
        CALL "pfbi_copy" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(7)
        CALL "pfbi_cmp" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(2) RETURNING WS-RC
        IF WS-RC > 0
            IF RD-STEP > 0
                CALL "pfbi_copy" USING BY VALUE BI-TEMP(3) BY VALUE BI-ONE
            ELSE
                CALL "pfbi_copy" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(2)
            END-IF
        END-IF
        CALL "pfbi_add_si" USING BY VALUE BI-TEMP(3) BY VALUE BI-TEMP(3) BY VALUE SIZE AUTO CM1
        CALL "pfbi_mod" USING BY VALUE BI-CHOICE BY VALUE BI-TEMP(3) BY VALUE BI-COUNT
        CALL "pfbi_add_si" USING BY VALUE BI-CHOICE BY VALUE BI-CHOICE BY VALUE SIZE AUTO C1
    END-IF
    CALL "pfbi_fits_i64" USING BY VALUE BI-CHOICE RETURNING WS-RC
    IF WS-RC = 1
        CALL "pfbi_get_i64" USING BY VALUE BI-CHOICE RETURNING WS-CHOICE-SMALL
    ELSE
        MOVE 0 TO WS-CHOICE-SMALL
    END-IF.

CACHE-SLOT-FOR-INDEX.
    COMPUTE WS-I64 = FUNCTION ABS(WS-INDEX)
    COMPUTE CACHE-SLOT = FUNCTION MOD(WS-I64, PF-CACHE-SIZE) + 1.

GATE-DISTANCE.
    PERFORM CACHE-SLOT-FOR-INDEX
    IF GD-VALID(CACHE-SLOT) = "Y" AND GD-INDEX(CACHE-SLOT) = WS-INDEX
        MOVE GD-DISTANCE(CACHE-SLOT) TO WS-I64
        EXIT PARAGRAPH
    END-IF
    MOVE PF-FOUNDATION-JDN TO SC-CALC-JDN
    COMPUTE SC-TARGET-JDN = PF-FOUNDATION-JDN + WS-INDEX
    PERFORM SAUCE
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    CALL "pfbi_set_ui" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO C922
    MOVE 1 TO CU-BOWL-ID
    MOVE 1 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    COMPUTE WS-I64 = WS-CHOICE-SMALL + 41
    MOVE "Y" TO GD-VALID(CACHE-SLOT)
    MOVE WS-INDEX TO GD-INDEX(CACHE-SLOT)
    MOVE WS-I64 TO GD-DISTANCE(CACHE-SLOT).

NEAREST-CHECKPOINT.
    MOVE 1 TO WS-START-ROW
    COMPUTE WS-I64 = FUNCTION ABS(WS-INDEX - CP-INDEX(1))
    PERFORM VARYING WS-I FROM 2 BY 1 UNTIL WS-I > PF-CHECKPOINT-COUNT
        COMPUTE WS-I64-2 = FUNCTION ABS(WS-INDEX - CP-INDEX(WS-I))
        IF WS-I64-2 < WS-I64
            MOVE WS-I64-2 TO WS-I64
            MOVE WS-I TO WS-START-ROW
        END-IF
    END-PERFORM.

GATE-POSITION.
    *> GATE-DISTANCE calls SAUCE, which deliberately uses the shared WS-*
    *> scratch area.  Preserve the caller scratch state and keep the gate
    *> accumulator outside that area so nested sauce evaluation cannot alter
    *> either the requested index or the position being accumulated.
    MOVE WS-I TO GP-SAVE-I
    MOVE WS-J TO GP-SAVE-J
    MOVE WS-K TO GP-SAVE-K
    MOVE WS-L TO GP-SAVE-L
    MOVE WS-POS TO GP-SAVE-POS
    MOVE WS-PLACE TO GP-SAVE-PLACE
    MOVE WS-BOWL-ID TO GP-SAVE-BOWL-ID
    MOVE WS-PREV-ID TO GP-SAVE-PREV-ID
    MOVE WS-NEXT-ID TO GP-SAVE-NEXT-ID
    MOVE WS-INDEX2 TO GP-SAVE-INDEX2
    MOVE WS-I64 TO GP-SAVE-I64
    MOVE WS-I64-3 TO GP-SAVE-I64-3
    MOVE WS-START-ROW TO GP-SAVE-START-ROW
    MOVE WS-END-ROW TO GP-SAVE-END-ROW

    MOVE WS-INDEX TO GP-TARGET-INDEX
    PERFORM CACHE-SLOT-FOR-INDEX
    IF GP-VALID(CACHE-SLOT) = "Y" AND GP-INDEX(CACHE-SLOT) = GP-TARGET-INDEX
        MOVE GP-JDN(CACHE-SLOT) TO GP-POSITION
    ELSE
        MOVE GP-TARGET-INDEX TO WS-INDEX
        PERFORM NEAREST-CHECKPOINT
        MOVE CP-INDEX(WS-START-ROW) TO WS-INDEX2
        MOVE CP-JDN(WS-START-ROW) TO GP-POSITION
        IF WS-INDEX2 < GP-TARGET-INDEX
            PERFORM UNTIL WS-INDEX2 >= GP-TARGET-INDEX
                IF WS-INDEX2 < 0
                    MOVE WS-INDEX2 TO WS-I64-3
                ELSE
                    COMPUTE WS-I64-3 = WS-INDEX2 + 1
                END-IF
                MOVE WS-I64-3 TO WS-INDEX
                PERFORM GATE-DISTANCE
                ADD WS-I64 TO GP-POSITION
                ADD 1 TO WS-INDEX2
                MOVE WS-INDEX2 TO WS-INDEX
                PERFORM CACHE-SLOT-FOR-INDEX
                MOVE "Y" TO GP-VALID(CACHE-SLOT)
                MOVE WS-INDEX2 TO GP-INDEX(CACHE-SLOT)
                MOVE GP-POSITION TO GP-JDN(CACHE-SLOT)
            END-PERFORM
        ELSE
            PERFORM UNTIL WS-INDEX2 <= GP-TARGET-INDEX
                IF WS-INDEX2 > 0
                    MOVE WS-INDEX2 TO WS-I64-3
                ELSE
                    COMPUTE WS-I64-3 = WS-INDEX2 - 1
                END-IF
                MOVE WS-I64-3 TO WS-INDEX
                PERFORM GATE-DISTANCE
                SUBTRACT WS-I64 FROM GP-POSITION
                SUBTRACT 1 FROM WS-INDEX2
                MOVE WS-INDEX2 TO WS-INDEX
                PERFORM CACHE-SLOT-FOR-INDEX
                MOVE "Y" TO GP-VALID(CACHE-SLOT)
                MOVE WS-INDEX2 TO GP-INDEX(CACHE-SLOT)
                MOVE GP-POSITION TO GP-JDN(CACHE-SLOT)
            END-PERFORM
        END-IF
    END-IF

    MOVE GP-POSITION TO WS-I64-2
    MOVE GP-TARGET-INDEX TO WS-INDEX
    MOVE GP-SAVE-I TO WS-I
    MOVE GP-SAVE-J TO WS-J
    MOVE GP-SAVE-K TO WS-K
    MOVE GP-SAVE-L TO WS-L
    MOVE GP-SAVE-POS TO WS-POS
    MOVE GP-SAVE-PLACE TO WS-PLACE
    MOVE GP-SAVE-BOWL-ID TO WS-BOWL-ID
    MOVE GP-SAVE-PREV-ID TO WS-PREV-ID
    MOVE GP-SAVE-NEXT-ID TO WS-NEXT-ID
    MOVE GP-SAVE-INDEX2 TO WS-INDEX2
    MOVE GP-SAVE-I64 TO WS-I64
    MOVE GP-SAVE-I64-3 TO WS-I64-3
    MOVE GP-SAVE-START-ROW TO WS-START-ROW
    MOVE GP-SAVE-END-ROW TO WS-END-ROW.

CONTAINING-GATE-INTERVAL.
    MOVE "N" TO WS-FOUND-FLAG
    IF WS-TARGET-JDN <= CP-JDN(1)
        MOVE CP-INDEX(1) TO WS-INDEX
    ELSE
        IF WS-TARGET-JDN > CP-JDN(PF-CHECKPOINT-COUNT)
            MOVE CP-INDEX(PF-CHECKPOINT-COUNT) TO WS-INDEX
        ELSE
            MOVE CP-INDEX(1) TO WS-INDEX
            PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I >= PF-CHECKPOINT-COUNT
                COMPUTE WS-J = WS-I + 1
                IF CP-JDN(WS-I) < WS-TARGET-JDN AND CP-JDN(WS-J) >= WS-TARGET-JDN
                    MOVE CP-INDEX(WS-I) TO WS-INDEX
                    MOVE PF-CHECKPOINT-COUNT TO WS-I
                END-IF
            END-PERFORM
        END-IF
    END-IF
    PERFORM GATE-POSITION
    IF WS-I64-2 >= WS-TARGET-JDN
        PERFORM UNTIL WS-I64-2 < WS-TARGET-JDN
            SUBTRACT 1 FROM WS-INDEX
            PERFORM GATE-POSITION
        END-PERFORM
    ELSE
        MOVE WS-INDEX TO WS-INDEX2
        PERFORM UNTIL WS-FOUND-FLAG = "Y"
            COMPUTE WS-INDEX = WS-INDEX2 + 1
            PERFORM GATE-POSITION
            IF WS-I64-2 < WS-TARGET-JDN
                ADD 1 TO WS-INDEX2
            ELSE
                MOVE "Y" TO WS-FOUND-FLAG
            END-IF
        END-PERFORM
        MOVE WS-INDEX2 TO WS-INDEX
        MOVE "N" TO WS-FOUND-FLAG
    END-IF.

GET-YEAR-5000.
    *> CONTAINING-GATE-INTERVAL uses WS-TARGET-JDN as its query input.
    *> Year 5000 is anchored around the calculation day, but callers still
    *> need their original target afterwards (notably FIND-YEAR/forward).
    MOVE WS-TARGET-JDN TO WS-SAVED-TARGET-JDN
    MOVE WS-CALCULATION-JDN TO WS-TARGET-JDN
    PERFORM CONTAINING-GATE-INTERVAL
    MOVE WS-SAVED-TARGET-JDN TO WS-TARGET-JDN
    MOVE WS-INDEX TO WS-INTERVAL-INDEX
    MOVE 0 TO OPEN-COUNT CLOSE-COUNT
    MOVE WS-INTERVAL-INDEX TO WS-INDEX2
    PERFORM UNTIL OPEN-COUNT >= PF-OPENING-MAX
        MOVE WS-INDEX2 TO WS-INDEX
        PERFORM GATE-POSITION
        COMPUTE WS-I64-3 = WS-CALCULATION-JDN - WS-I64-2
        IF WS-I64-3 > PF-MAX-YEAR-DAYS
            EXIT PERFORM
        END-IF
        ADD 1 TO OPEN-COUNT
        MOVE WS-INDEX2 TO OPEN-P(OPEN-COUNT)
        MOVE WS-I64-2 TO OPEN-JDN(OPEN-COUNT)
        SUBTRACT 1 FROM WS-INDEX2
    END-PERFORM
    MOVE WS-INTERVAL-INDEX TO WS-INDEX2
    ADD 1 TO WS-INDEX2
    PERFORM UNTIL CLOSE-COUNT >= PF-OPENING-MAX
        MOVE WS-INDEX2 TO WS-INDEX
        PERFORM GATE-POSITION
        COMPUTE WS-I64-3 = WS-I64-2 - WS-CALCULATION-JDN
        IF WS-I64-3 > PF-MAX-YEAR-DAYS
            EXIT PERFORM
        END-IF
        ADD 1 TO CLOSE-COUNT
        MOVE WS-INDEX2 TO CLOSE-Q(CLOSE-COUNT)
        MOVE WS-I64-2 TO CLOSE-JDN(CLOSE-COUNT)
        ADD 1 TO WS-INDEX2
    END-PERFORM
    MOVE 0 TO WS-CANDIDATE-COUNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > OPEN-COUNT
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > CLOSE-COUNT
            COMPUTE WS-I64 = CLOSE-Q(WS-J) - OPEN-P(WS-I)
            COMPUTE WS-I64-2 = CLOSE-JDN(WS-J) - OPEN-JDN(WS-I)
            IF WS-I64 >= PF-MIN-YEAR-GAPS AND WS-I64-2 >= PF-MIN-YEAR-DAYS AND WS-I64-2 <= PF-MAX-YEAR-DAYS
                ADD 1 TO WS-CANDIDATE-COUNT
            END-IF
        END-PERFORM
    END-PERFORM
    IF WS-CANDIDATE-COUNT = 0
        MOVE 902 TO PF-STATUS
        MOVE "ERR_YEAR_5000" TO PF-STATUS-CODE
        MOVE "no valid year-5000 candidate was found" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    MOVE WS-CALCULATION-JDN TO SC-CALC-JDN SC-TARGET-JDN
    PERFORM SAUCE
    MOVE WS-CANDIDATE-COUNT TO WS-I64
    CALL "pfbi_set_ui" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64
    MOVE 1 TO CU-BOWL-ID
    MOVE 10 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE WS-CHOICE-SMALL TO WS-CANDIDATE-ORDINAL
    MOVE "N" TO WS-SELECTED-FLAG
    PERFORM VARYING WS-LENGTH FROM PF-MIN-YEAR-DAYS BY 1 UNTIL WS-LENGTH > PF-MAX-YEAR-DAYS OR WS-SELECTED-FLAG = "Y"
        PERFORM VARYING WS-I FROM OPEN-COUNT BY -1 UNTIL WS-I < 1 OR WS-SELECTED-FLAG = "Y"
            PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > CLOSE-COUNT OR WS-SELECTED-FLAG = "Y"
                COMPUTE WS-I64 = CLOSE-Q(WS-J) - OPEN-P(WS-I)
                COMPUTE WS-I64-2 = CLOSE-JDN(WS-J) - OPEN-JDN(WS-I)
                IF WS-I64 >= PF-MIN-YEAR-GAPS AND WS-I64-2 = WS-LENGTH
                    SUBTRACT 1 FROM WS-CANDIDATE-ORDINAL
                    IF WS-CANDIDATE-ORDINAL = 0
                        MOVE 5000 TO Y-NUMBER
                        MOVE OPEN-P(WS-I) TO Y-P
                        MOVE CLOSE-Q(WS-J) TO Y-Q
                        PERFORM BUILD-YEAR-OBJECT
                        MOVE "Y" TO WS-SELECTED-FLAG
                    END-IF
                END-IF
            END-PERFORM
        END-PERFORM
    END-PERFORM
    IF WS-SELECTED-FLAG NOT = "Y"
        MOVE 903 TO PF-STATUS
        MOVE "ERR_YEAR_SELECT" TO PF-STATUS-CODE
        MOVE "year-5000 selection rank was not materialized" TO PF-STATUS-MESSAGE
    END-IF.

BUILD-YEAR-OBJECT.
    MOVE Y-P TO WS-INDEX
    PERFORM GATE-POSITION
    COMPUTE Y-START = WS-I64-2 + 1
    MOVE Y-Q TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO Y-END
    COMPUTE Y-LENGTH = Y-END - Y-START + 1
    COMPUTE Y-GAPS = Y-Q - Y-P.

NEXT-YEAR.
    MOVE Y-Q TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO WS-I64-3
    MOVE 0 TO WS-CANDIDATE-COUNT
    COMPUTE WS-INDEX2 = Y-Q + PF-MIN-YEAR-GAPS
    PERFORM UNTIL WS-FOUND-FLAG = "Y"
        MOVE WS-INDEX2 TO WS-INDEX
        PERFORM GATE-POSITION
        COMPUTE WS-I64 = WS-I64-2 - WS-I64-3
        IF WS-I64 > PF-MAX-YEAR-DAYS
            MOVE "Y" TO WS-FOUND-FLAG
        ELSE
            IF WS-I64 >= PF-MIN-YEAR-DAYS ADD 1 TO WS-CANDIDATE-COUNT END-IF
            ADD 1 TO WS-INDEX2
        END-IF
    END-PERFORM
    MOVE "N" TO WS-FOUND-FLAG
    MOVE WS-CALCULATION-JDN TO SC-CALC-JDN
    MOVE Y-Q TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO SC-TARGET-JDN
    PERFORM SAUCE
    MOVE WS-CANDIDATE-COUNT TO WS-I64
    CALL "pfbi_set_ui" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64
    MOVE 1 TO CU-BOWL-ID
    MOVE 11 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE WS-CHOICE-SMALL TO WS-CANDIDATE-ORDINAL
    MOVE Y-Q TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO WS-I64-3
    COMPUTE WS-INDEX2 = Y-Q + PF-MIN-YEAR-GAPS
    PERFORM UNTIL WS-CANDIDATE-ORDINAL = 0
        MOVE WS-INDEX2 TO WS-INDEX
        PERFORM GATE-POSITION
        COMPUTE WS-I64 = WS-I64-2 - WS-I64-3
        IF WS-I64 >= PF-MIN-YEAR-DAYS AND WS-I64 <= PF-MAX-YEAR-DAYS
            SUBTRACT 1 FROM WS-CANDIDATE-ORDINAL
        END-IF
        IF WS-CANDIDATE-ORDINAL > 0 ADD 1 TO WS-INDEX2 END-IF
    END-PERFORM
    ADD 1 TO Y-NUMBER
    MOVE Y-Q TO Y-P
    MOVE WS-INDEX2 TO Y-Q
    PERFORM BUILD-YEAR-OBJECT.

PREVIOUS-YEAR.
    MOVE Y-P TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO WS-I64-3
    MOVE 0 TO WS-CANDIDATE-COUNT
    COMPUTE WS-INDEX2 = Y-P - PF-MIN-YEAR-GAPS
    PERFORM UNTIL WS-FOUND-FLAG = "Y"
        MOVE WS-INDEX2 TO WS-INDEX
        PERFORM GATE-POSITION
        COMPUTE WS-I64 = WS-I64-3 - WS-I64-2
        IF WS-I64 > PF-MAX-YEAR-DAYS
            MOVE "Y" TO WS-FOUND-FLAG
        ELSE
            IF WS-I64 >= PF-MIN-YEAR-DAYS ADD 1 TO WS-CANDIDATE-COUNT END-IF
            SUBTRACT 1 FROM WS-INDEX2
        END-IF
    END-PERFORM
    MOVE "N" TO WS-FOUND-FLAG
    MOVE WS-CALCULATION-JDN TO SC-CALC-JDN
    MOVE Y-P TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO SC-TARGET-JDN
    PERFORM SAUCE
    MOVE WS-CANDIDATE-COUNT TO WS-I64
    CALL "pfbi_set_ui" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64
    MOVE 1 TO CU-BOWL-ID
    MOVE 12 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE WS-CHOICE-SMALL TO WS-CANDIDATE-ORDINAL
    MOVE Y-P TO WS-INDEX
    PERFORM GATE-POSITION
    MOVE WS-I64-2 TO WS-I64-3
    COMPUTE WS-INDEX2 = Y-P - PF-MIN-YEAR-GAPS
    PERFORM UNTIL WS-CANDIDATE-ORDINAL = 0
        MOVE WS-INDEX2 TO WS-INDEX
        PERFORM GATE-POSITION
        COMPUTE WS-I64 = WS-I64-3 - WS-I64-2
        IF WS-I64 >= PF-MIN-YEAR-DAYS AND WS-I64 <= PF-MAX-YEAR-DAYS
            SUBTRACT 1 FROM WS-CANDIDATE-ORDINAL
        END-IF
        IF WS-CANDIDATE-ORDINAL > 0 SUBTRACT 1 FROM WS-INDEX2 END-IF
    END-PERFORM
    SUBTRACT 1 FROM Y-NUMBER
    MOVE Y-P TO Y-Q
    MOVE WS-INDEX2 TO Y-P
    PERFORM BUILD-YEAR-OBJECT.

FIND-YEAR.
    PERFORM GET-YEAR-5000
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    IF WS-TARGET-JDN < Y-START
        PERFORM UNTIL WS-TARGET-JDN >= Y-START
            PERFORM PREVIOUS-YEAR
        END-PERFORM
    ELSE
        PERFORM UNTIL WS-TARGET-JDN <= Y-END
            PERFORM NEXT-YEAR
        END-PERFORM
    END-IF.

FIND-YEAR-BY-NUMBER.
    PERFORM GET-YEAR-5000
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM UNTIL Y-NUMBER = PF-WANTED-YEAR
        IF Y-NUMBER < PF-WANTED-YEAR
            PERFORM NEXT-YEAR
        ELSE
            PERFORM PREVIOUS-YEAR
        END-IF
    END-PERFORM.

BUILD-STRUCTURE.
    INITIALIZE STRUCTURE
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 47
        MOVE 0 TO SEEN-MONTH(WS-I)
    END-PERFORM

    *> GATE-POSITION can call GATE-DISTANCE, which runs SAUCE and therefore
    *> overwrites the global bowl/permutation state. Resolve the mandatory
    *> internal gate first; only then compute the year-structure sauce that
    *> must remain intact for all subsequent choices.
    MOVE "N" TO MANDATORY-PRESENT
    MOVE -1 TO MANDATORY-CUT WS-COMP-MANDATORY
    IF WS-CALCULATION-JDN >= Y-START AND WS-CALCULATION-JDN <= Y-END
        COMPUTE WS-INDEX2 = Y-P + 1
        PERFORM UNTIL WS-INDEX2 >= Y-Q OR MANDATORY-PRESENT = "Y"
            MOVE WS-INDEX2 TO WS-INDEX
            PERFORM GATE-POSITION
            IF WS-I64-2 = WS-CALCULATION-JDN
                COMPUTE MANDATORY-CUT = WS-INDEX2 - Y-P
                MOVE MANDATORY-CUT TO WS-COMP-MANDATORY
                MOVE "Y" TO MANDATORY-PRESENT
            END-IF
            ADD 1 TO WS-INDEX2
        END-PERFORM
    END-IF

    MOVE WS-CALCULATION-JDN TO SC-CALC-JDN
    MOVE Y-START TO SC-TARGET-JDN
    PERFORM SAUCE
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF

    MOVE Y-GAPS TO WS-HIGH
    IF WS-HIGH > 17 MOVE 17 TO WS-HIGH END-IF
    COMPUTE WS-OPTIONS = WS-HIGH - 5
    MOVE WS-OPTIONS TO WS-I64
    CALL "pfbi_set_ui" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64
    MOVE 2 TO CU-BOWL-ID
    MOVE 20 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    COMPUTE ST-CUTLET-COUNT = 5 + WS-CHOICE-SMALL
    IF MANDATORY-PRESENT = "Y"
        COMPUTE WS-I64 = Y-GAPS - 2
        COMPUTE WS-I64-2 = ST-CUTLET-COUNT - 2
    ELSE
        COMPUTE WS-I64 = Y-GAPS - 1
        COMPUTE WS-I64-2 = ST-CUTLET-COUNT - 1
    END-IF
    CALL "pfbi_binomial" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64 BY VALUE SIZE AUTO WS-I64-2
    MOVE 2 TO CU-BOWL-ID
    MOVE 21 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE PF-MAX-CUTLETS TO WS-J
    CALL "pfcu_unrank_composition" USING
        BY VALUE SIZE AUTO Y-GAPS
        BY VALUE SIZE AUTO ST-CUTLET-COUNT
        BY VALUE SIZE AUTO WS-COMP-MANDATORY
        BY VALUE BI-CHOICE
        BY REFERENCE ST-CUTLET-GAPS(1)
        BY VALUE SIZE AUTO WS-J
        RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 910 TO PF-STATUS
        MOVE "ERR_CUTLET_UNRANK" TO PF-STATUS-CODE
        MOVE "generic composition unranking failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF

    MOVE ST-CUTLET-COUNT TO WS-I64-2
    CALL "pfbi_permutations" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO C17 BY VALUE SIZE AUTO WS-I64-2
    MOVE 5 TO CU-BOWL-ID
    MOVE 22 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE 17 TO WS-J
    MOVE PF-MAX-CUTLETS TO WS-K
    CALL "pfcu_unrank_permutation" USING
        BY VALUE SIZE AUTO WS-J
        BY VALUE SIZE AUTO ST-CUTLET-COUNT
        BY VALUE BI-CHOICE
        BY REFERENCE ST-CUTLET-NAME-INDEX(1)
        BY VALUE SIZE AUTO WS-K
        RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 911 TO PF-STATUS
        MOVE "ERR_CUTLET_NAMES" TO PF-STATUS-CODE
        MOVE "cutlet-name permutation unranking failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ST-CUTLET-COUNT
        ADD 1 TO ST-CUTLET-NAME-INDEX(WS-I)
    END-PERFORM

    COMPUTE WS-MIN-MONTHS = (Y-LENGTH + 122) / 123
    COMPUTE WS-MAX-MONTHS = Y-LENGTH / 4
    IF WS-MAX-MONTHS > 47 MOVE 47 TO WS-MAX-MONTHS END-IF
    COMPUTE WS-OPTIONS = WS-MAX-MONTHS - WS-MIN-MONTHS + 1
    MOVE WS-OPTIONS TO WS-I64
    CALL "pfbi_set_ui" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64
    MOVE 3 TO CU-BOWL-ID
    MOVE 30 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    COMPUTE ST-MONTH-COUNT = WS-MIN-MONTHS + WS-CHOICE-SMALL - 1

    MOVE 4 TO WS-LOW
    MOVE 123 TO WS-HIGH
    CALL "pfcu_bounded_count" USING
        BY VALUE SIZE AUTO Y-LENGTH BY VALUE SIZE AUTO ST-MONTH-COUNT BY VALUE SIZE AUTO WS-LOW BY VALUE SIZE AUTO WS-HIGH BY VALUE BI-COUNT
        RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 912 TO PF-STATUS
        MOVE "ERR_MONTH_COUNT" TO PF-STATUS-CODE
        MOVE "bounded month-length count failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    MOVE 3 TO CU-BOWL-ID
    MOVE 31 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE PF-MAX-MONTHS TO WS-J
    CALL "pfcu_unrank_bounded" USING
        BY VALUE SIZE AUTO Y-LENGTH BY VALUE SIZE AUTO ST-MONTH-COUNT BY VALUE SIZE AUTO WS-LOW BY VALUE SIZE AUTO WS-HIGH
        BY VALUE BI-CHOICE BY REFERENCE ST-MONTH-LENGTH(1) BY VALUE SIZE AUTO WS-J
        RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 913 TO PF-STATUS
        MOVE "ERR_MONTH_LENGTHS" TO PF-STATUS-CODE
        MOVE "month-length unranking failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF

    CALL "pfci_count" USING BY REFERENCE ST-MONTH-LENGTH(1) BY VALUE SIZE AUTO ST-MONTH-COUNT BY VALUE BI-COUNT RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 914 TO PF-STATUS
        MOVE "ERR_INTERLEAVING_COUNT" TO PF-STATUS-CODE
        MOVE "month interleaving count failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    MOVE 4 TO CU-BOWL-ID
    MOVE 32 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE PF-MAX-YEAR-LENGTH TO WS-J
    CALL "pfci_unrank" USING
        BY REFERENCE ST-MONTH-LENGTH(1) BY VALUE SIZE AUTO ST-MONTH-COUNT BY VALUE BI-CHOICE
        BY REFERENCE ST-MONTH-WEAVE(1) BY VALUE SIZE AUTO WS-J RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 915 TO PF-STATUS
        MOVE "ERR_INTERLEAVING" TO PF-STATUS-CODE
        MOVE "month interleaving unranking failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > Y-LENGTH
        ADD 1 TO ST-MONTH-WEAVE(WS-I)
    END-PERFORM

    MOVE 47 TO WS-I64
    MOVE ST-MONTH-COUNT TO WS-I64-2
    CALL "pfbi_permutations" USING BY VALUE BI-COUNT BY VALUE SIZE AUTO WS-I64 BY VALUE SIZE AUTO WS-I64-2
    MOVE 5 TO CU-BOWL-ID
    MOVE 33 TO CU-SEAL
    PERFORM CHOOSE-UNIFORM
    MOVE 47 TO WS-J
    MOVE ST-MONTH-COUNT TO WS-K
    MOVE PF-MAX-MONTHS TO WS-L
    CALL "pfcu_unrank_permutation" USING
        BY VALUE SIZE AUTO WS-J BY VALUE SIZE AUTO WS-K BY VALUE BI-CHOICE
        BY REFERENCE ST-MONTH-NAME-INDEX(1) BY VALUE SIZE AUTO WS-L RETURNING WS-RC
    IF WS-RC NOT = 0
        MOVE 916 TO PF-STATUS
        MOVE "ERR_MONTH_NAMES" TO PF-STATUS-CODE
        MOVE "month-name permutation unranking failed" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ST-MONTH-COUNT
        ADD 1 TO ST-MONTH-NAME-INDEX(WS-I)
    END-PERFORM

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 47
        MOVE 0 TO SEEN-MONTH(WS-I)
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > Y-LENGTH
        MOVE ST-MONTH-WEAVE(WS-I) TO WS-J
        ADD 1 TO SEEN-MONTH(WS-J)
        MOVE SEEN-MONTH(WS-J) TO ST-DAY-IN-MONTH(WS-I)
    END-PERFORM

    MOVE 0 TO GAP-OFFSET DAY-OFFSET
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ST-CUTLET-COUNT
        MOVE DAY-OFFSET TO ST-CUTLET-START(WS-I)
        ADD ST-CUTLET-GAPS(WS-I) TO GAP-OFFSET
        COMPUTE WS-INDEX = Y-P + GAP-OFFSET
        PERFORM GATE-POSITION
        COMPUTE DAY-OFFSET = WS-I64-2 - Y-START + 1
        COMPUTE ST-CUTLET-END(WS-I) = DAY-OFFSET - 1
    END-PERFORM.

MATERIALIZE.
    COMPUTE CUTLET-OFFSET = WS-TARGET-JDN - Y-START
    MOVE 0 TO CUTLET-INDEX
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ST-CUTLET-COUNT OR CUTLET-INDEX > 0
        IF CUTLET-OFFSET >= ST-CUTLET-START(WS-I) AND CUTLET-OFFSET <= ST-CUTLET-END(WS-I)
            MOVE WS-I TO CUTLET-INDEX
        END-IF
    END-PERFORM
    IF CUTLET-INDEX = 0
        MOVE 917 TO PF-STATUS
        MOVE "ERR_CUTLET_INTERNAL" TO PF-STATUS-CODE
        MOVE "target day was not contained in a cutlet" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-I = CUTLET-OFFSET + 1
    MOVE ST-MONTH-WEAVE(WS-I) TO MONTH-INDEX
    MOVE Y-NUMBER TO PF-YEAR
    MOVE CUTLET-INDEX TO PF-CUTLET-INDEX
    MOVE ST-CUTLET-NAME-INDEX(CUTLET-INDEX) TO WS-J
    MOVE CUTLET-NAMES(WS-J) TO PF-CUTLET-NAME
    COMPUTE PF-DAY-IN-CUTLET = CUTLET-OFFSET - ST-CUTLET-START(CUTLET-INDEX) + 1
    MOVE MONTH-INDEX TO PF-MONTH-INDEX
    MOVE ST-MONTH-NAME-INDEX(MONTH-INDEX) TO WS-J
    MOVE MONTH-NAMES(WS-J) TO PF-MONTH-NAME
    MOVE ST-DAY-IN-MONTH(WS-I) TO PF-DAY-IN-MONTH.

FORWARD-CALCULATE.
    MOVE 0 TO PF-STATUS
    MOVE SPACES TO PF-STATUS-CODE PF-STATUS-MESSAGE
    PERFORM FIND-YEAR
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM BUILD-STRUCTURE
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM MATERIALIZE.

WANTED-MATCHES-RESPONSE.
    MOVE "N" TO REVERSE-FOUND
    IF PF-YEAR = PF-WANTED-YEAR
       AND PF-CUTLET-NAME = PF-WANTED-CUTLET-NAME
       AND PF-DAY-IN-CUTLET = PF-WANTED-DAY-IN-CUTLET
       AND PF-MONTH-NAME = PF-WANTED-MONTH-NAME
       AND PF-DAY-IN-MONTH = PF-WANTED-DAY-IN-MONTH
        MOVE "Y" TO REVERSE-FOUND
    END-IF.

REVERSE-KNOWN-C.
    MOVE 0 TO PF-STATUS PF-RESULT-COUNT
    MOVE "N" TO PF-FOUND PF-HAS-MORE
    PERFORM FIND-YEAR-BY-NUMBER
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM BUILD-STRUCTURE
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE 0 TO CUTLET-INDEX
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ST-CUTLET-COUNT OR CUTLET-INDEX > 0
        MOVE ST-CUTLET-NAME-INDEX(WS-I) TO WS-J
        IF CUTLET-NAMES(WS-J) = PF-WANTED-CUTLET-NAME
            MOVE WS-I TO CUTLET-INDEX
        END-IF
    END-PERFORM
    IF CUTLET-INDEX = 0 EXIT PARAGRAPH END-IF
    COMPUTE CUTLET-OFFSET = ST-CUTLET-START(CUTLET-INDEX) + PF-WANTED-DAY-IN-CUTLET - 1
    IF CUTLET-OFFSET < ST-CUTLET-START(CUTLET-INDEX) OR CUTLET-OFFSET > ST-CUTLET-END(CUTLET-INDEX)
        EXIT PARAGRAPH
    END-IF
    COMPUTE REVERSE-TARGET-JDN = Y-START + CUTLET-OFFSET
    MOVE REVERSE-TARGET-JDN TO WS-TARGET-JDN
    PERFORM FORWARD-CALCULATE
    IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM WANTED-MATCHES-RESPONSE
    IF REVERSE-FOUND = "Y"
        MOVE "Y" TO PF-FOUND
        MOVE REVERSE-TARGET-JDN TO PF-FOUND-TARGET-JDN PF-RESULT-JDN(1)
        MOVE 1 TO PF-RESULT-COUNT
    END-IF.

REVERSE-SELF-PAGE.
    MOVE 0 TO PF-STATUS PF-RESULT-COUNT
    MOVE "N" TO PF-FOUND PF-HAS-MORE
    IF PF-SEARCH-END-JDN < PF-SEARCH-START-JDN
        MOVE 120 TO PF-STATUS
        MOVE "ERR_SELF_RANGE" TO PF-STATUS-CODE
        MOVE "search end precedes search start" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    IF PF-SEARCH-START-JDN > PF-JDN-MAX-LIMIT OR PF-SEARCH-START-JDN < PF-JDN-MIN-LIMIT
       OR PF-SEARCH-END-JDN > PF-JDN-MAX-LIMIT OR PF-SEARCH-END-JDN < PF-JDN-MIN-LIMIT
        MOVE 101 TO PF-STATUS
        MOVE "ERR_JDN_RANGE" TO PF-STATUS-CODE
        MOVE "search range exceeds the reference COBOL int64 safety profile" TO PF-STATUS-MESSAGE
        EXIT PARAGRAPH
    END-IF
    IF PF-WANTED-YEAR NOT = 5000 EXIT PARAGRAPH END-IF
    MOVE PF-RESULT-LIMIT TO REVERSE-LIMIT
    IF REVERSE-LIMIT < 1 OR REVERSE-LIMIT > PF-RESULT-MAX MOVE PF-RESULT-MAX TO REVERSE-LIMIT END-IF
    MOVE PF-SEARCH-START-JDN TO REVERSE-SCAN-JDN
    PERFORM UNTIL REVERSE-SCAN-JDN > PF-SEARCH-END-JDN OR PF-RESULT-COUNT >= REVERSE-LIMIT
        MOVE REVERSE-SCAN-JDN TO WS-CALCULATION-JDN WS-TARGET-JDN
        PERFORM FORWARD-CALCULATE
        IF PF-STATUS NOT = 0 EXIT PARAGRAPH END-IF
        PERFORM WANTED-MATCHES-RESPONSE
        IF REVERSE-FOUND = "Y"
            ADD 1 TO PF-RESULT-COUNT
            MOVE REVERSE-SCAN-JDN TO PF-RESULT-JDN(PF-RESULT-COUNT)
            IF PF-FOUND NOT = "Y"
                MOVE "Y" TO PF-FOUND
                MOVE REVERSE-SCAN-JDN TO PF-FOUND-TARGET-JDN
            END-IF
        END-IF
        ADD 1 TO REVERSE-SCAN-JDN
    END-PERFORM
    IF REVERSE-SCAN-JDN <= PF-SEARCH-END-JDN
        MOVE "Y" TO PF-HAS-MORE
        MOVE REVERSE-SCAN-JDN TO PF-NEXT-START-JDN
    END-IF.
END PROGRAM PASTAFARI-ENGINE.
