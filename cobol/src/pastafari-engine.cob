COPY "pastafari-engine.cpy".

PROCEDURE DIVISION USING PF-REQUEST PF-RESPONSE.
MAIN-ENTRY.
    INITIALIZE PF-RESPONSE
    MOVE 1 TO PF-API-VERSION
    MOVE "cobol-fast" TO PF-IMPLEMENTATION
    MOVE "PASTAFARI-TABLETS-2026-08-06-V1" TO PF-ALGORITHM-ID
    MOVE "N" TO PF-FOUND PF-HAS-MORE
    IF WS-INITIALIZED NOT = "Y"
        PERFORM INIT-ALL
        IF WS-INITIALIZED NOT = "Y"
            MOVE 900 TO PF-STATUS
            MOVE "ERR_INIT" TO PF-STATUS-CODE
            MOVE "COBOL engine initialization failed" TO PF-STATUS-MESSAGE
            GOBACK
        END-IF
    END-IF

    EVALUATE PF-OP
        WHEN "F"
            MOVE PF-CALCULATION-JDN TO WS-CALCULATION-JDN
            MOVE PF-TARGET-JDN TO WS-TARGET-JDN
            PERFORM VALIDATE-JDNS
            IF PF-STATUS = 0
                PERFORM FORWARD-CALCULATE
            END-IF
        WHEN "K"
            PERFORM VALIDATE-WANTED
            IF PF-STATUS = 0
                MOVE PF-CALCULATION-JDN TO WS-CALCULATION-JDN
                PERFORM VALIDATE-CALC-JDN
            END-IF
            IF PF-STATUS = 0
                PERFORM REVERSE-KNOWN-C
            END-IF
        WHEN "S"
            PERFORM VALIDATE-WANTED
            IF PF-STATUS = 0
                PERFORM REVERSE-SELF-PAGE
            END-IF
        WHEN OTHER
            MOVE 100 TO PF-STATUS
            MOVE "ERR_OPERATION" TO PF-STATUS-CODE
            MOVE "PF-OP must be F, K or S" TO PF-STATUS-MESSAGE
    END-EVALUATE
    GOBACK.

VALIDATE-JDNS.
    PERFORM VALIDATE-CALC-JDN
    IF PF-STATUS = 0
        IF WS-TARGET-JDN > PF-JDN-MAX-LIMIT OR WS-TARGET-JDN < PF-JDN-MIN-LIMIT
            MOVE 101 TO PF-STATUS
            MOVE "ERR_JDN_RANGE" TO PF-STATUS-CODE
            MOVE "target JDN exceeds the reference COBOL int64 safety profile" TO PF-STATUS-MESSAGE
        END-IF
    END-IF.

VALIDATE-CALC-JDN.
    IF WS-CALCULATION-JDN > PF-JDN-MAX-LIMIT OR WS-CALCULATION-JDN < PF-JDN-MIN-LIMIT
        MOVE 101 TO PF-STATUS
        MOVE "ERR_JDN_RANGE" TO PF-STATUS-CODE
        MOVE "calculation JDN exceeds the reference COBOL int64 safety profile" TO PF-STATUS-MESSAGE
    END-IF.

VALIDATE-WANTED.
    IF PF-WANTED-DAY-IN-CUTLET < 1 OR PF-WANTED-DAY-IN-MONTH < 1
       OR PF-WANTED-CUTLET-NAME = SPACES OR PF-WANTED-MONTH-NAME = SPACES
        MOVE 121 TO PF-STATUS
        MOVE "ERR_PASTAFARI_LOOKUP" TO PF-STATUS-CODE
        MOVE "reverse lookup requires names and positive day numbers" TO PF-STATUS-MESSAGE
    END-IF.

INIT-ALL.
    PERFORM INIT-BIGINTS
    IF WS-RC NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM INIT-CONSTANT-TABLES
    PERFORM INIT-NAMES
    PERFORM INIT-CHECKPOINTS
    PERFORM INIT-STONES
    IF WS-RC = 0
        MOVE "Y" TO WS-INITIALIZED
    END-IF.

*> Numeric arguments passed BY VALUE to the C runtime use SIZE AUTO.
*> GnuCOBOL otherwise defaults BY VALUE numeric arguments to 4 bytes;
*> SIZE AUTO preserves the native COMP-5 width across supported hosts.
INIT-BIGINTS.
    MOVE 0 TO WS-RC
    CALL "pfbi_new" RETURNING BI-GREAT
    CALL "pfbi_new" RETURNING BI-ZERO
    CALL "pfbi_new" RETURNING BI-ONE
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 24
        CALL "pfbi_new" RETURNING BI-TEMP(WS-I)
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 7
        CALL "pfbi_new" RETURNING BI-HIDDEN(WS-I)
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 46
        CALL "pfbi_new" RETURNING BI-DROPS(WS-I)
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 5
            CALL "pfbi_new" RETURNING BI-STONE(WS-I, WS-J)
        END-PERFORM
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
        CALL "pfbi_new" RETURNING BI-BOWLS(WS-I)
        CALL "pfbi_new" RETURNING BI-NEXT-BOWLS(WS-I)
        CALL "pfbi_new" RETURNING BI-DIRECT(WS-I)
    END-PERFORM
    CALL "pfbi_new" RETURNING BI-COUNT
    CALL "pfbi_new" RETURNING BI-CHOICE
    CALL "pfbi_new" RETURNING BI-RANK
    CALL "pfbi_new" RETURNING BI-BLOCK
    CALL "pfbi_new" RETURNING BI-REMAINDER
    CALL "pfbi_new" RETURNING BI-NUMERATOR
    CALL "pfbi_new" RETURNING BI-DENOMINATOR
    CALL "pfbi_new" RETURNING RD-FIRST
    IF BI-GREAT = NULL OR BI-ZERO = NULL OR BI-ONE = NULL
        MOVE 1 TO WS-RC
        EXIT PARAGRAPH
    END-IF
    CALL "pfbi_set_ui" USING BY VALUE BI-ZERO BY VALUE SIZE AUTO C0
    CALL "pfbi_set_ui" USING BY VALUE BI-ONE BY VALUE SIZE AUTO C1
    CALL "pfbi_set_ui" USING BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO C2
    MOVE 127 TO WS-I64
    CALL "pfbi_pow_ui" USING BY VALUE BI-GREAT BY VALUE BI-TEMP(1) BY VALUE SIZE AUTO WS-I64
    CALL "pfbi_add_si" USING BY VALUE BI-GREAT BY VALUE BI-GREAT BY VALUE SIZE AUTO CM1.

